# =============================================================================
# CodePilot AI — Environment Configuration
# =============================================================================
# Copy this to .env and fill in your values

# Django
SECRET_KEY=change-this-to-a-random-string
DEBUG=True

# Database (omit for SQLite in development)
# DATABASE_URL=postgres://user:password@localhost:5432/codepilot

# Redis (needed for Celery background tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=change-this-to-a-random-string

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Options: "groq" (free), "openai" (paid), "ollama" (local), "mock" (no AI)
LLM_PROVIDER=groq

# Groq (FREE — recommended for development)
# Get your key: https://console.groq.com/keys
# Free models: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (PAID — recommended for production)
# Get your key: https://platform.openai.com/api-keys
# Models: gpt-4o-mini ($0.15/1M input), gpt-4o ($2.50/1M input)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (LOCAL — no API key needed)
# Install: https://ollama.ai
# Then: ollama pull codellama:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# =============================================================================
# GitHub Integration
# =============================================================================
# Create OAuth App: https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Security
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
